{
  "name": "agy-bridge-pi",
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "build": "bun build extensions/index.ts --outdir dist --target node --external typebox --external '@earendil-works/*'",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": ["./dist/index.js"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85",
    "@types/bun": "latest",
    "agy-bridge-engine": "workspace:*",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiptime/agy-bridge.git"
  }
}

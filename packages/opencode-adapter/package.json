{
  "name": "agy-bridge-opencode",
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts src/provider.ts src/tui.ts --outdir dist --target bun --external @opentui/solid --external solid-js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./provider": {
      "types": "./src/provider.ts",
      "default": "./dist/provider.js"
    },
    "./tui": {
      "types": "./src/tui.ts",
      "default": "./dist/tui.js"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@opencode-ai/plugin": "1.18.30",
    "@ai-sdk/provider": "3.0.8"
  },
  "devDependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@opencode-ai/plugin": "1.18.30",
    "@opencode-ai/sdk": "1.18.30",
    "@opentui/solid": "^0.5.14",
    "@types/bun": "latest",
    "agy-bridge-engine": "workspace:*",
    "solid-js": "^1.9.15",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiptime/agy-bridge.git"
  }
}
